---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: string;
  excerpt?: string;
  categories?: string[];
  tags?: string[];
}

const { title, date, excerpt, categories = [], tags = [] } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title}>
  <article class="max-w-4xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      <div class="text-gray-600 mb-4">
        <time datetime={date}>{formattedDate}</time>
      </div>
      {excerpt && <p class="text-lg text-gray-700 italic">{excerpt}</p>}
      {(categories.length > 0 || tags.length > 0) && (
        <div class="mt-4 flex gap-4 flex-wrap">
          {categories.length > 0 && (
            <div>
              <span class="font-semibold text-gray-700">Categories:</span>
              <div class="flex gap-2 mt-1">
                {categories.map((cat) => (
                  <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded text-sm">
                    {cat}
                  </span>
                ))}
              </div>
            </div>
          )}
          {tags.length > 0 && (
            <div>
              <span class="font-semibold text-gray-700">Tags:</span>
              <div class="flex gap-2 mt-1">
                {tags.map((tag) => (
                  <span class="bg-gray-100 text-gray-800 px-3 py-1 rounded text-sm">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </header>

    <main class="prose prose-lg max-w-none">
      <slot />
    </main>
  </article>
</BaseLayout>
