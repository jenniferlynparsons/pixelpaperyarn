---

interface Props {
  title: string;
  date: string;
  excerpt?: string;
  categories?: string[];
  tags?: string[];
}

const { title, date, excerpt, categories = [], tags = [] } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Helper function to convert category name to URL slug
function categoryToSlug(category: string): string {
  return category.toLowerCase().replace(/\s+/g, '-');
}

function tagToSlug(tag: string): string {
  return tag.toLowerCase().replace(/\s+/g, '-');
}
---

<article class="hentry post type-post status-publish format-standard bg-white relative pt-content-v border-t border-gray-200/10 mx-0 md:mx-20 mb-24">
  <header class="entry-header px-20">
    <h1 class="entry-title">{title}</h1>
    <div class="entry-meta">
      <time datetime={date} class="entry-date published">{formattedDate}</time>
    </div>
  </header>

  <div class="entry-content px-20 pb-content-v">
    <slot />
  </div>

  {(categories.length > 0 || tags.length > 0) && (
    <footer class="entry-footer px-20 pb-content-v">
      <div class="entry-meta">
        {categories.length > 0 && (
          <span class="cat-links inline">
            <span class="text-gray-600">Posted in </span>
            {categories.map((cat, index) => (
              <>
                <a href={`/categories/${categoryToSlug(cat)}`} rel="category tag">
                  {cat}
                </a>
                {index < categories.length - 1 && <span>, </span>}
              </>
            ))}
          </span>
        )}
        {tags.length > 0 && (
          <span class="tags-links inline ml-4">
            <span class="text-gray-600">Tagged </span>
            {tags.map((tag, index) => (
              <>
                <a href={`/tags/${tagToSlug(tag)}`} rel="tag">
                  {tag}
                </a>
                {index < tags.length - 1 && <span>, </span>}
              </>
            ))}
          </span>
        )}
      </div>
    </footer>
  )}
</article>
