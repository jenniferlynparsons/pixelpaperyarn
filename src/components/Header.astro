---
interface Props {
  siteTitle?: string;
}

const { siteTitle = 'Pixel Paper Yarn' } = Astro.props;
---

<header class="bg-white shadow-sm">
  <nav class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <a href="/" class="text-2xl font-bold text-gray-900 hover:text-blue-600 transition-colors">
        {siteTitle}
      </a>
    </div>
    <ul class="flex gap-6">
      <li>
        <a href="/" class="text-gray-700 hover:text-blue-600 transition-colors">
          Home
        </a>
      </li>
      <li>
        <a href="/blog" class="text-gray-700 hover:text-blue-600 transition-colors">
          Blog
        </a>
      </li>
      <li>
        <a href="/about" class="text-gray-700 hover:text-blue-600 transition-colors">
          About
        </a>
      </li>
    </ul>
  </nav>
</header>
