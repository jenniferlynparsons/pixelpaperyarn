---
import { categoryToSlug } from '../utils/slugs';

interface Props {
  post: any;
  showFullContent?: boolean;
}

const { post, showFullContent = true } = Astro.props;
const Content = post.Content;
---

<article class="hentry post type-post status-publish format-standard bg-white relative pt-content-v border-t border-gray-200/10 mx-0 md:mx-auto mb-24 md:max-w-3xl">
  <header class="entry-header px-10 md:px-20 ">
    <h2 class="entry-title font-sans font-bold text-2xl sm:text-3xl lg:text-4xl mb-4">
      <a href={`/blog/${post.data.slug || post.slug}`} rel="bookmark">
        {post.data.title}
      </a>
    </h2>
  </header>

  <div class="entry-content px-10 md:px-20 pb-content-v">
    <Content />
  </div>

  <footer class="entry-footer px-10 md:px-20  pb-content-v">
    <div class="entry-meta text-sm text-gray-600">
      <span class="posted-on">
        <span class="screen-reader-text">Posted on </span>
        <time class="entry-date published" datetime={post.data.date.toString()}>
          {new Date(post.data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
      </span>
      {post.data.categories && post.data.categories.length > 0 && (
        <span class="cat-links">
          <span class="screen-reader-text">Categories </span>
          {post.data.categories.map((cat: string, i: number) => (
            <>
              <a href={`/categories/${categoryToSlug(cat)}`} rel="category tag">
                {cat}
              </a>
              {i < (post.data.categories?.length ?? 0) - 1 && <span>, </span>}
            </>
          ))}
        </span>
      )}
    </div>
  </footer>
</article>
