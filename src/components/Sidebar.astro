<script>
  // Dropdown toggle functionality
  document.querySelectorAll('.dropdown-toggle').forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const parentLi = this.closest('li');
      const submenu = parentLi?.querySelector('.sub-menu');
      const isExpanded = this.getAttribute('aria-expanded') === 'true';

      if (submenu) {
        submenu.classList.toggle('hidden');
        submenu.classList.toggle('toggled-on');
        this.setAttribute('aria-expanded', (!isExpanded).toString());
      }
    });
  });

  // Mobile menu toggle functionality
  const secondaryToggle = document.querySelector('.secondary-toggle');
  const secondary = document.querySelector('.secondary');
  const sidebar = document.getElementById('sidebar');

  if (secondaryToggle && secondary) {
    secondaryToggle.addEventListener('click', function(e) {
      e.preventDefault();
      secondary.classList.toggle('toggled-on');
      sidebar?.classList.toggle('toggled-on');
      this.classList.toggle('toggled-on');
    });
  }
</script>

<style>
  .dropdown-toggle {
    position: absolute;
    right: 0;
    top: 0;
    background: transparent;
    border: 0;
    height: 42px;
    width: 42px;
    cursor: pointer;
    padding: 0;
  }

  .dropdown-toggle:after {
    content: "▼";
    font-size: 12px;
    position: relative;
    width: 42px;
    height: 42px;
    line-height: 42px;
    display: block;
    color: rgba(51, 51, 51, 0.7);
    text-align: center;
    transition: transform 0.2s ease;
  }

  .dropdown-toggle[aria-expanded="true"]:after {
    transform: rotate(180deg);
  }

  .screen-reader-text {
    clip: rect(1px, 1px, 1px, 1px);
    height: 1px;
    overflow: hidden;
    position: absolute !important;
    width: 1px;
    word-wrap: normal !important;
  }

  .menu-item-has-children {
    position: relative;
  }

  .menu-item-has-children > a {
    padding-right: 48px;
  }

  .sub-menu.toggled-on {
    display: block !important;
  }

  .cat-item {
    line-height: 1.6;
  }

  .widget ul li {
    line-height: 1.6;
  }

  /* Mobile menu toggle button */
  .site-branding {
    position: relative;
  }

  .secondary-toggle {
    background-color: transparent;
    border: 1px solid #eaeaea;
    border: 1px solid rgba(51, 51, 51, 0.1);
    border-radius: 0;
    cursor: pointer;
    height: 42px;
    margin: 0;
    padding: 0;
    position: absolute;
    right: 0;
    top: 0;
    width: 42px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }

  .icon-bar {
    background-color: #333;
    display: block;
    height: 2px;
    width: 24px;
    transition: all 0.3s ease;
  }

  .secondary-toggle.toggled-on .icon-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .secondary-toggle.toggled-on .icon-bar:nth-child(2) {
    opacity: 0;
  }

  .secondary-toggle.toggled-on .icon-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .secondary-toggle:hover,
  .secondary-toggle:focus {
    background-color: transparent;
    border-color: #333;
  }

  /* Hide secondary on mobile by default */
  @media screen and (max-width: 59.6875em) {
    .secondary {
      background-color: #fff;
      display: none;
      padding: 0;
      margin: 0;
    }

    .secondary.toggled-on {
      display: block;
      box-shadow: 0 0 1px rgba(0, 0, 0, 0.15);
      padding: 7.6923% 7.6923% 0;
    }

    .sidebar.toggled-on {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow-y: auto;
      z-index: 1000;
    }
  }

  /* Hide hamburger button on desktop */
  @media screen and (min-width: 59.6875em) {
    .secondary-toggle {
      display: none;
    }

    .secondary {
      display: block !important;
    }
  }
</style>
