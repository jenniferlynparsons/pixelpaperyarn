---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

// Extract all tags
const allTags = new Set<string>();
posts.forEach((post) => {
  if (post.data.tags) {
    post.data.tags.forEach((tag) => allTags.add(tag));
  }
});

const tags = Array.from(allTags).sort();

function tagToSlug(tag: string): string {
  return tag.toLowerCase().replace(/\s+/g, '-');
}
---

<BaseLayout title="Tags - Pixel Paper Yarn">
  <PageLayout title="Tags">
    {tags.length === 0 ? (
      <p class="text-gray-600">No tags found.</p>
    ) : (
      <div class="flex flex-wrap gap-3">
        {tags.map((tag) => {
          const postCount = posts.filter((p) => p.data.tags?.includes(tag)).length;
          return (
            <a href={`/tags/${tagToSlug(tag)}`} class="bg-gray-200 text-gray-800 px-4 py-2 rounded-lg hover:bg-teal-600 hover:text-white transition-colors cursor-pointer block">
              <span class="font-semibold">#{tag}</span>
              <span class="text-sm ml-2">({postCount})</span>
            </a>
          );
        })}
      </div>
    )}
  </PageLayout>
</BaseLayout>
