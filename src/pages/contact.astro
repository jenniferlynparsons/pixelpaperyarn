---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout title="Contact - Pixel Paper Yarn">
  <h1 class="text-4xl font-bold mb-8">Contact</h1>
  
  <div class="max-w-lg prose text-gray-700">
    <p class="mb-6">
      Have a question or just want to say hello? Feel free to reach out!
    </p>
    <p class="mb-4">
      Email: <a href="mailto:hello@pixelpaperyarn.com" class="text-teal-600 hover:text-teal-800">hello@pixelpaperyarn.com</a>
    </p>
    <p>
      You can also find me on social media or check out my projects on GitHub.
    </p>
  </div>
</BlogLayout>
