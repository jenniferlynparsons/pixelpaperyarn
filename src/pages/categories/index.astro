---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

// Get all unique categories with post counts
const categoryMap = new Map<string, number>();
posts.forEach((post) => {
  if (post.data.categories) {
    post.data.categories.forEach((cat) => {
      const count = categoryMap.get(cat) || 0;
      categoryMap.set(cat, count + 1);
    });
  }
});

// Sort categories alphabetically
const categories = Array.from(categoryMap.entries())
  .sort((a, b) => a[0].localeCompare(b[0]));

function categoryToSlug(category: string): string {
  return category.toLowerCase().replace(/\s+/g, '-');
}
---

<BaseLayout title="Categories - Pixel Paper Yarn">
  <PageLayout title="Categories">
    {categories.length === 0 ? (
      <p class="text-gray-600">No categories found.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {categories.map(([category, count]) => (
          <a
            href={`/categories/${categoryToSlug(category)}`}
            class="bg-white border-2 border-gray-200 p-6 rounded-lg hover:border-teal-600 hover:shadow-lg transition-all"
          >
            <h2 class="text-xl font-bold mb-2">{category}</h2>
            <p class="text-gray-600">
              {count} {count === 1 ? 'post' : 'posts'}
            </p>
          </a>
        ))}
      </div>
    )}
  </PageLayout>
</BaseLayout>
