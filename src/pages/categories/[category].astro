---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  // Get all unique categories
  const categorySet = new Set<string>();
  posts.forEach((post) => {
    if (post.data.categories) {
      post.data.categories.forEach((cat) => categorySet.add(cat));
    }
  });

  // Create a path for each category with rendered content
  const paths = await Promise.all(
    Array.from(categorySet).map(async (category) => {
      const categoryPosts = posts
        .filter((p) =>
          p.data.categories?.some(c => c.toLowerCase() === category.toLowerCase())
        )
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

      const postsWithContent = await Promise.all(
        categoryPosts.map(async (post) => ({
          ...post,
          Content: (await post.render()).Content
        }))
      );

      return {
        params: { category: category.toLowerCase().replace(/\s+/g, '-') },
        props: {
          category,
          posts: postsWithContent
        },
      };
    })
  );

  return paths;
}

function categoryToSlug(category: string): string {
  return category.toLowerCase().replace(/\s+/g, '-');
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} - Pixel Paper Yarn`}>
  <header class="bg-white relative pt-content-v border-t border-gray-200/10 mx-0 md:mx-20 mb-24">
    <div class="px-20">
      <h1 class="entry-title font-sans font-bold text-4xl mb-4">{category}</h1>
      <p class="text-gray-600 mb-4">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </div>
  </header>

  {posts.map((post: any) => (
    <article class="hentry post type-post status-publish format-standard bg-white relative pt-content-v border-t border-gray-200/10 mx-0 md:mx-20 mb-24">
      <header class="entry-header px-20">
        <h2 class="entry-title">
          <a href={`/blog/${post.data.slug || post.slug}`} rel="bookmark">
            {post.data.title}
          </a>
        </h2>
      </header>

      <div class="entry-content px-20 pb-content-v">
        <post.Content />
      </div>

      <footer class="entry-footer px-20 pb-content-v">
        <div class="entry-meta text-sm text-gray-600">
          <span class="posted-on">
            <span class="screen-reader-text">Posted on </span>
            <time class="entry-date published" datetime={post.data.date.toString()}>
              {new Date(post.data.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </span>
          {post.data.categories && post.data.categories.length > 0 && (
            <span class="cat-links">
              <span class="screen-reader-text">Categories </span>
              {post.data.categories.map((cat: string, i: number) => (
                <>
                  <a href={`/categories/${categoryToSlug(cat)}`} rel="category tag">
                    {cat}
                  </a>
                  {i < (post.data.categories?.length ?? 0) - 1 && <span>, </span>}
                </>
              ))}
            </span>
          )}
        </div>
      </footer>
    </article>
  ))}
</BaseLayout>
