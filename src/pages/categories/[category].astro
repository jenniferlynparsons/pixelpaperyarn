---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleEntry from '../../components/ArticleEntry.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  // Get all unique categories
  const categorySet = new Set<string>();
  posts.forEach((post) => {
    if (post.data.categories) {
      post.data.categories.forEach((cat) => categorySet.add(cat));
    }
  });

  // Create a path for each category with rendered content
  const paths = await Promise.all(
    Array.from(categorySet).map(async (category) => {
      const categoryPosts = posts
        .filter((p) =>
          p.data.categories?.some(c => c.toLowerCase() === category.toLowerCase())
        )
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

      const postsWithContent = await Promise.all(
        categoryPosts.map(async (post) => ({
          ...post,
          Content: (await post.render()).Content
        }))
      );

      return {
        params: { category: category.toLowerCase().replace(/\s+/g, '-') },
        props: {
          category,
          posts: postsWithContent
        },
      };
    })
  );

  return paths;
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} - Pixel Paper Yarn`}>
  <header class="bg-white relative pt-content-v pb-content-v border-t border-gray-200/10 mx-0 md:mx-auto mb-24 md:max-w-3xl">
    <div class="px-10 md:px-20  text-center">
      <h1 class="entry-title font-sans font-bold text-2xl sm:text-3xl lg:text-4xl mb-4">{category}</h1>
      <p class="text-gray-600">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </div>
  </header>

  {posts.map((post: any) => (
    <ArticleEntry post={post} />
  ))}
</BaseLayout>
