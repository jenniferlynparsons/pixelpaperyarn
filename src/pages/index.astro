---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Pixel Paper Yarn">
	<Header />
	<main class="max-w-4xl mx-auto px-4 py-12">
		<section class="mb-12">
			<h1 class="text-5xl font-bold mb-4">Welcome to Pixel Paper Yarn</h1>
			<p class="text-xl text-gray-700 mb-8">
				A creative space exploring design, craft, and digital art.
			</p>
		</section>

		<section>
			<h2 class="text-3xl font-bold mb-6">Recent Posts</h2>
			<div class="grid gap-6">
				<article class="border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
					<h3 class="text-2xl font-bold mb-2">
						<a href="#">Blog posts will appear here</a>
					</h3>
					<p class="text-gray-600 mb-4">
						Once you import your WordPress content, your posts will be listed here.
					</p>
					<a href="#" class="text-blue-600 hover:text-blue-800 font-semibold">
						Read more →
					</a>
				</article>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
