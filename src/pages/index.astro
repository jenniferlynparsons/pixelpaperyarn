---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
	.slice(0, 10);
---

<BaseLayout>
	<section class="mb-12">
		<h1 class="text-4xl font-bold mb-4">Welcome</h1>
		<p class="text-lg text-gray-700 mb-8">
			A creative space exploring design, craft, and digital art.
		</p>
	</section>

	<section>
		<h2 class="text-3xl font-bold mb-6">Recent Posts</h2>
		{recentPosts.length === 0 ? (
			<p class="text-gray-600">No posts yet. Check back soon!</p>
		) : (
			<div class="space-y-4">
				{recentPosts.map((post) => (
					<article class="border-b border-gray-200 pb-4 last:border-b-0">
						<h3 class="text-xl font-bold mb-2">
							<a href={`/blog/${post.data.slug}`} class="text-teal-600 hover:text-teal-800 transition-colors">
								{post.data.title}
							</a>
						</h3>
						<div class="flex flex-col sm:flex-row sm:items-center sm:gap-4 text-sm text-gray-600">
							<time>
								{new Date(post.data.date).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</time>
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="flex gap-2">
									{post.data.tags.map((tag) => (
										<span class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded">
											{tag}
										</span>
									))}
								</div>
							)}
						</div>
					</article>
				))}
			</div>
		)}
		<div class="mt-8">
			<a href="/blog" class="text-teal-600 hover:text-teal-800 font-semibold text-lg transition-colors">
				View all posts →
			</a>
		</div>
	</section>
</BaseLayout>
