---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleEntry from '../components/ArticleEntry.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Get first 5 posts for page 1
const recentPosts = await Promise.all(
	sortedPosts
		.slice(0, 5)
		.map(async (post) => ({
			...post,
			Content: (await post.render()).Content
		}))
);

// Calculate total pages for pagination
const pageSize = 5;
const totalPages = Math.ceil(sortedPosts.length / pageSize);
---

<BaseLayout>
	{recentPosts.length === 0 ? (
		<p class="text-gray-600">No posts yet. Check back soon!</p>
	) : (
		<>
			{recentPosts.map((post) => (
				<ArticleEntry post={post} />
			))}

			{/* Pagination */}
			<nav class="pagination bg-white border-t border-gray-200/10 py-8 px-10 md:px-20  mx-0 md:mx-20">
				<div class="nav-links flex justify-center items-center gap-2">
					<span class="page-numbers current px-4 py-2 bg-gray-800 text-white rounded">
						1
					</span>

					{totalPages > 1 && (
						<>
							{totalPages > 1 && (
								<a href="/blog/2" class="page-numbers px-4 py-2 hover:bg-gray-100 rounded">
									2
								</a>
							)}

							{totalPages > 2 && (
								<span class="page-numbers dots px-2">…</span>
							)}

							{totalPages > 2 && (
								<a href={`/blog/${totalPages}`} class="page-numbers px-4 py-2 hover:bg-gray-100 rounded">
									{totalPages}
								</a>
							)}

							<a href="/blog/2" class="next page-numbers px-4 py-2 bg-gray-800 text-white hover:bg-gray-700 rounded flex items-center gap-2">
								<span>→</span>
							</a>
						</>
					)}
				</div>
			</nav>
		</>
	)}
</BaseLayout>
