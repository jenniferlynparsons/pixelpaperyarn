---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
	.slice(0, 10);

function categoryToSlug(category: string): string {
  return category.toLowerCase().replace(/\s+/g, '-');
}
---

<BaseLayout>
	{recentPosts.length === 0 ? (
		<p class="text-gray-600">No posts yet. Check back soon!</p>
	) : (
		<>
			{recentPosts.map((post, index) => (
				<article class={`hentry post type-post status-publish format-standard ${index > 0 ? 'border-top' : ''}`}>
					<header class="entry-header">
						<h2 class="entry-title">
							<a href={`/blog/${post.data.slug}`} rel="bookmark">
								{post.data.title}
							</a>
						</h2>
					</header>

					<div class="entry-summary">
						{post.data.excerpt && <p>{post.data.excerpt}</p>}
						<div class="entry-meta">
							<time class="entry-date published" datetime={post.data.date.toString()}>
								{new Date(post.data.date).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</time>
							{post.data.categories && post.data.categories.length > 0 && (
								<span class="cat-links" style="display: block; margin-top: 0.5em;">
									<span style="color: rgba(51, 51, 51, 0.7);">Posted in </span>
									{post.data.categories.map((cat, i) => (
										<>
											<a href={`/categories/${categoryToSlug(cat)}`} rel="category tag">
												{cat}
											</a>
											{i < post.data.categories.length - 1 && <span>, </span>}
										</>
									))}
								</span>
							)}
						</div>
					</div>
				</article>
			))}
		</>
	)}
</BaseLayout>
